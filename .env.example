# Optional. Any OpenAI-compatible chat-completions API works; without a key,
# the local keyword parser is used.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_TIMEOUT=20

# Optional. Register this exact loopback URI in your Spotify app settings.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
